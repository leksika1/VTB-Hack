{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend", "--", "--host", "127.0.0.1", "--port", "5173", "--strictPort"],
      "env": { "VITE_API_PROXY": "http://localhost:8010" },
      "port": 5173
    },
    {
      "name": "frontend-docker",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend", "--", "--host", "127.0.0.1", "--port", "5173", "--strictPort"],
      "env": { "VITE_API_PROXY": "http://127.0.0.1:18080" },
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "backend", "--reload", "--reload-dir", "backend/app", "--port", "8010"],
      "port": 8010,
      "autoPort": false
    }
  ]
}
