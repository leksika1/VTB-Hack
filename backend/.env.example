# Полный список с пояснениями: docs/OPERATIONS.md
# Значения по умолчанию уже указывают на PostgreSQL и Redis из docker-compose.dev.yml
DATABASE_URL=postgresql+asyncpg://family:family@localhost:55432/family
REDIS_URL=redis://:family@localhost:6379/0
CORS_ORIGINS=http://localhost:5173
TIMEZONE=Europe/Moscow
SESSION_TTL_DAYS=90
DEMO_TTL_HOURS=24
RATE_LIMIT_ENABLED=true
LOG_LEVEL=INFO
